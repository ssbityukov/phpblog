{
    "name": "sbityukov/php-blog",
    "description": "Blog on plain PHP with MySQL and Smarty",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "smarty/smarty": "^5.4",
        "ext-pdo": "*",
        "ext-gd": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
