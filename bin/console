#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Core\Config;
use App\Core\Database;
use App\Database\Migrator;
use App\Database\Seeder;

require __DIR__ . '/../vendor/autoload.php';

$root = dirname(__DIR__);
$command = $argv[1] ?? '';

try {
    $config = Config::fromFile($root . '/.env');
    $database = new Database($config);
    $migrator = new Migrator($database->pdo(), $root . '/database/migrations');

    switch ($command) {
        case 'migrate':
            $applied = $migrator->migrate();
            echo $applied === []
                ? "Nothing to migrate.\n"
                : sprintf("Applied %d migration(s):\n  %s\n", count($applied), implode("\n  ", $applied));
            break;

        case 'migrate:fresh':
            $name = (string) $config->get('DB_DATABASE', 'blog');

            if (!in_array('--force', $argv, true) && !confirmDatabaseWipe($name)) {
                echo "Aborted.\n";
                exit(1);
            }

            $applied = $migrator->fresh();
            echo sprintf("Dropped every table in \"%s\" and applied %d migration(s).\n", $name, count($applied));
            break;

        case 'migrate:status':
            foreach ($migrator->status() as $row) {
                $state = match (true) {
                    $row['missing'] => 'missing file',
                    $row['applied_at'] !== null => 'applied ' . $row['applied_at'],
                    default => 'pending',
                };

                echo sprintf("  %-32s %s\n", $row['migration'], $state);
            }
            break;

        case 'seed':
            $seeder = new Seeder($database->pdo(), $root . '/public/uploads/posts');
            $seeder->run(in_array('--fresh', $argv, true));
            echo "Seed completed.\n";
            break;

        default:
            fwrite(STDERR, "Usage: php bin/console migrate | migrate:fresh [--force] | migrate:status | seed [--fresh]\n");
            exit(1);
    }
} catch (Throwable $error) {
    fwrite(STDERR, 'Error: ' . $error->getMessage() . "\n");
    exit(1);
}

/** Просит подтвердить снос базы, набрав её имя. Без TTY отказывает. */
function confirmDatabaseWipe(string $database): bool
{
    if (!stream_isatty(STDIN)) {
        fwrite(STDERR, "migrate:fresh drops every table. Re-run with --force in a non-interactive shell.\n");

        return false;
    }

    printf('Это сотрёт ВСЕ таблицы базы "%s" без возможности отката. Введите имя базы для подтверждения: ', $database);

    return trim((string) fgets(STDIN)) === $database;
}
