DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=blog
DB_USERNAME=blog
# Заполнить своими значениями. .env не трекается — секреты не попадают в git.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
# Порт, на котором база видна с хоста (только на 127.0.0.1).
DB_PORT_HOST=3307

APP_PORT=8080
APP_URL=http://localhost:8080
APP_DEBUG=0
